{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The workspace packages are consumed as TypeScript source — there is no
    // build step anywhere in this repo — so their `.ts` import specifiers have
    // to be allowed through.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // `test/` runs under `node --test` with Node globals this config does not
  // model; it is typechecked by actually running it.
  "include": ["*.tsx", "src/**/*.ts", "src/**/*.tsx", "../../packages/*/src/**/*.ts"]
}
