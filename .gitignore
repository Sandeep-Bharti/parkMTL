node_modules/
# Upstream CSVs are large (30 MB+) and refreshed daily; always re-fetch.
data/raw/
# Build artifacts are published to GitHub Releases, never committed.
data/out/
data/basemap/
*.geojsonl
*.pmtiles
*.sqlite

# Staged copies of the artifacts above; recreated by scripts/build/stage-assets.sh.
apps/mobile/assets/data/

# Generated by `expo prebuild`; the config in app.json is the source of truth.
apps/*/ios/
apps/*/android/

.DS_Store
.expo/
dist/

# Apple/Google credential files for eas submit. Paths are referenced from
# eas.json (not secret); the files themselves must never be committed.
apps/mobile/secrets/
